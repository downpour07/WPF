<Window x:Class="wpf.LoginScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d"
        Title="LoginScreen"
        Height="1080"
        Width="1920"
>
    <Grid>
        <Border
            Background="#FFFFFF" 
            Width="650" 
            Height="800" 
            CornerRadius="30"
        >
            <Border.Effect>
                <DropShadowEffect
                    Color="#000000"
                    BlurRadius="30"
                    Opacity="0.15"
                />
            </Border.Effect>
            <StackPanel Margin="70,90,70,60">
                <TextBlock
                    Text="WELCOME"
                    FontSize="32"
                    Foreground="#151515"
                    FontWeight="SemiBold"
                />
                <TextBlock
                    Text="BACK!"
                    FontSize="32"
                    Foreground="#151515"
                    FontWeight="SemiBold"
                />
                <StackPanel Margin="0,60,0,0">
                    <StackPanel>
                        <TextBlock
                            Text="아이디"
                            FontSize="16"
                            Foreground="#151515"
                            FontWeight="SemiBold"
                        />
                        <Border BorderBrush="#B0B0B0" CornerRadius="5" Margin="0,10,0,0" BorderThickness="1" Padding="3">
                            <TextBox
                                Width="500"
                                Height="45"
                                FontSize="16"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                            />
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,70,0,0">
                        <TextBlock
                            Text="비밀번호"
                            FontSize="16"
                            Foreground="#151515"
                            FontWeight="SemiBold"
                        />
                        <Border BorderBrush="#B0B0B0" CornerRadius="5" Margin="0,10,0,0" BorderThickness="1" Padding="3">
                            <PasswordBox 
                                Width="500"
                                Height="45"
                                FontSize="16"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                            />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button
                    Width="500"
                    Height="55"
                    Content="로그인"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#5F85EF"
                    BorderThickness="0"
                    Margin="0,130,0,0"
                >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                            >
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                >
                    <TextBlock
                        Text="아직 계정이 없으신가요?"
                        FontSize="16"
                        Foreground="#151515"
                        Margin="0,0,5,0"
                    />
                    <Button
                        Content="회원가입"
                        FontSize="16"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#3EBAE3"
                        Padding="0,0,0,0"
                        Margin="0,0,5,0"
                        FontWeight="Medium"
                        Click="onSignupButton"
                    />
                    <TextBlock
                        Text="하러가기!"
                        FontSize="16"
                        Foreground="#151515"
                    />
                </StackPanel>
            </StackPanel>
        </Border>
        <Button
            Width="30"
            Height="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,20,20"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0"
        >
            <Image
                Source="file:///C:/Users/choih/Desktop/repo/WPF/wpf/wpf/assets/Setting.png"
                Stretch="Fill"
            />
        </Button>
    </Grid>
</Window>
